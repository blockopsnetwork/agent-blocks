# Slack
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...          # for Socket Mode
SLACK_SIGNING_SECRET=...

# GitHub
GITHUB_TOKEN=ghp_...
GITHUB_APP_ID=                    # optional: use GitHub App instead of PAT
GITHUB_APP_PRIVATE_KEY=

# AI
ANTHROPIC_API_KEY=sk-ant-...

# Orchestrator
MAX_CONCURRENT_AGENTS=5
POLL_INTERVAL_MS=30000
STALL_TIMEOUT_MS=300000
WORKSPACE_ROOT=/tmp/agent-blocks/workspaces

# Logging
LOG_LEVEL=info

# Meta-agent IDs (from: npx tsx src/meta-agents/setup.ts)
META_AGENT_ENV_ID=env_...
META_AGENT_PSA_ID=agent_...
META_AGENT_PSA_VERSION=1
META_AGENT_DEVOPSEC_ID=agent_...
META_AGENT_DEVOPSEC_VERSION=1

# ARC Coder Runner
WORKFLOW_REPO_OWNER=blockopsnetwork
WORKFLOW_REPO_NAME=agent-blocks
BLOCKS_CALLBACK_URL=https://blocks.yourdomain.com
BLOCKS_CALLBACK_PORT=3001

# Redis (optional — falls back to InMemoryJobStore if unset)
REDIS_URL=redis://localhost:6379
